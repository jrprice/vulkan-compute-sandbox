               OpCapability Shader
               OpCapability Float16
               OpCapability StorageBuffer16BitAccess
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %out %lhs_values %rhs_values
               OpExecutionMode %main LocalSize 1 1 1
               OpDecorate %array ArrayStride 4
               OpMemberDecorate %struct 0 Offset 0
               OpDecorate %struct Block
               OpDecorate %out DescriptorSet 0
               OpDecorate %out Binding 0

       %uint = OpTypeInt 32 0
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
    %uint_15 = OpConstant %uint 15

       %bool = OpTypeBool
       %void = OpTypeVoid
  %main_type = OpTypeFunction %void

       %half = OpTypeFloat 16
     %v2half = OpTypeVector %half 2
      %array = OpTypeArray %v2half %uint_15
     %struct = OpTypeStruct %array

     %half_4 = OpConstant %half 0x1p+2
     %half_1 = OpConstant %half 0x1p+0
   %v2half_4 = OpConstantComposite %v2half %half_4 %half_4
   %v2half_1 = OpConstantComposite %v2half %half_1 %half_1
 %arr_half_4 = OpConstantComposite %array %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4 %v2half_4
 %arr_half_1 = OpConstantComposite %array %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1 %v2half_1

%_ptr_Function_uint = OpTypePointer Function %uint
%_ptr_Private_v2half = OpTypePointer Private %v2half
%_ptr_Private__array = OpTypePointer Private %array
%_ptr_StorageBuffer_v2half = OpTypePointer StorageBuffer %v2half
%_ptr_StorageBuffer__struct = OpTypePointer StorageBuffer %struct

 %lhs_values = OpVariable %_ptr_Private__array Private %arr_half_4
 %rhs_values = OpVariable %_ptr_Private__array Private %arr_half_1
        %out = OpVariable %_ptr_StorageBuffer__struct StorageBuffer

       %main = OpFunction %void None %main_type
 %main_start = OpLabel
    %idx_var = OpVariable %_ptr_Function_uint Function %uint_0

               OpBranch %loop_header
%loop_header = OpLabel
               OpLoopMerge %loop_merge %continuing None
               OpBranch %loop_cond
  %loop_cond = OpLabel
        %idx = OpLoad %uint %idx_var None
  %idx_lt_15 = OpULessThan %bool %idx %uint_15
               OpSelectionMerge %loop_body None
               OpBranchConditional %idx_lt_15 %loop_body %loop_merge

  %loop_body = OpLabel
    %lhs_ptr = OpAccessChain %_ptr_Private_v2half %lhs_values %idx
    %rhs_ptr = OpAccessChain %_ptr_Private_v2half %rhs_values %idx
        %lhs = OpLoad %v2half %lhs_ptr None
        %rhs = OpLoad %v2half %rhs_ptr None
        %add = OpFAdd %v2half %lhs %rhs
    %out_ptr = OpAccessChain %_ptr_StorageBuffer_v2half %out %uint_0 %idx
               OpStore %out_ptr %add None
               OpBranch %continuing

 %continuing = OpLabel
        %inc = OpIAdd %uint %idx %uint_1
               OpStore %idx_var %inc None
               OpBranch %loop_header

 %loop_merge = OpLabel
               OpReturn
               OpFunctionEnd
