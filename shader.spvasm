               OpCapability Shader
               OpCapability Float16
               OpCapability StorageBuffer16BitAccess
               OpCapability UniformAndStorageBuffer16BitAccess
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %outputs %inputs
               OpExecutionMode %main LocalSize 1 1 1
               OpName %main "main"
               OpName %inputs_block "inputs_block"
               OpName %outputs_block "outputs_block"
               OpDecorate %arr_half_uint_128 ArrayStride 2
               OpMemberDecorate %outputs_block 0 Offset 0
               OpDecorate %outputs_block Block
               OpDecorate %outputs DescriptorSet 0
               OpDecorate %outputs Binding 0
               OpMemberDecorate %inputs_block 0 Offset 0
               OpDecorate %inputs_block Block
               OpDecorate %inputs DescriptorSet 0
               OpDecorate %inputs Binding 1
               OpDecorate %inputs NonWritable

       %half = OpTypeFloat 16
       %uint = OpTypeInt 32 0
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
   %uint_128 = OpConstant %uint 128

%arr_half_uint_128 = OpTypeArray %half %uint_128

%inputs_block = OpTypeStruct %arr_half_uint_128
%ptr_Uniform_half = OpTypePointer Uniform %half
%ptr_Uniform_inputs_block = OpTypePointer Uniform %inputs_block
     %inputs = OpVariable %ptr_Uniform_inputs_block Uniform

%outputs_block = OpTypeStruct %arr_half_uint_128
%ptr_StorageBuffer_half = OpTypePointer StorageBuffer %half
%ptr_StorageBuffer_outputs_block = OpTypePointer StorageBuffer %outputs_block
          %outputs = OpVariable %ptr_StorageBuffer_outputs_block StorageBuffer

       %void = OpTypeVoid
         %16 = OpTypeFunction %void
       %bool = OpTypeBool

       %main = OpFunction %void None %16
         %17 = OpLabel
               OpBranch %21
         %21 = OpLabel
        %idx = OpPhi %uint %uint_0 %17 %idx_inc %continuing
               OpLoopMerge %22 %continuing None
               OpBranch %19
         %19 = OpLabel
         %28 = OpSLessThan %bool %idx %uint_128
               OpSelectionMerge %31 None
               OpBranchConditional %28 %31 %22
         %31 = OpLabel
         %39 = OpAccessChain %ptr_Uniform_half %inputs %uint_0 %idx
         %34 = OpAccessChain %ptr_StorageBuffer_half %outputs %uint_0 %idx
         %42 = OpLoad %half %39 None
               OpStore %34 %42
               OpBranch %continuing
 %continuing = OpLabel
    %idx_inc = OpIAdd %uint %idx %uint_1
               OpBranch %21
         %22 = OpLabel
               OpReturn
               OpFunctionEnd
